# JDEconomy AI Work - Variables de Entorno
# Copia este archivo a .env y completa con tus valores reales

# ID de tu cuenta de Cloudflare
CLOUDFLARE_ACCOUNT_ID=tu_account_id_aqui

# Token de API de Cloudflare (con permiso para Workers AI)
CLOUDFLARE_API_TOKEN=tu_api_token_aqui

# AI Gateway (opcional, si usas Cloudflare AI Gateway)
CLOUDFLARE_AI_GATEWAY=opcional_si_usas_gateway